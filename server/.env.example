# ═══════════════════════════════════════════════════════════════════════════════
# A.B.E.L — Configuration Serveur
# Copiez ce fichier en .env et remplissez vos valeurs
# ═══════════════════════════════════════════════════════════════════════════════

# ─── LLM Provider ──────────────────────────────────────────────────────────────
# Valeurs: auto | ollama | groq | openai | mock
# auto = détecte automatiquement dans l'ordre: Ollama → Groq → OpenAI → Mock
LLM_PROVIDER=auto

# ─── Ollama (LOCAL, 100% GRATUIT — RECOMMANDÉ) ─────────────────────────────────
# Installation: curl -fsSL https://ollama.com/install.sh | sh
# Puis: ollama pull llama3.2
#
# Modèles recommandés:
#   llama3.2       (2 GB)  — Rapide et précis, idéal usage quotidien
#   mistral        (4 GB)  — Excellent pour le code
#   phi3           (2 GB)  — Léger et efficace
#   deepseek-r1    (4 GB)  — Raisonnement avancé (style o1)
#   gemma2         (5 GB)  — Google, très performant
#   qwen2.5-coder  (4 GB)  — Spécialisé code
#   llama3.1:70b   (40 GB) — Meilleur local (GPU requis)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=120

# ─── Groq (CLOUD GRATUIT — 14 400 requêtes/jour) ──────────────────────────────
# Compte GRATUIT: https://console.groq.com
# Modèles: llama-3.3-70b-versatile, mixtral-8x7b-32768, gemma2-9b-it
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ─── OpenAI (PAYANT — Fallback optionnel) ──────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=onyx

# ─── Supabase (BASE DE DONNÉES) ────────────────────────────────────────────────
# Projet gratuit: https://supabase.com
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Sécurité ──────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=changez-cette-cle-en-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173

# ─── Agent Tools (tous gratuits, sans clé API) ─────────────────────────────────
ENABLE_WEB_SEARCH=true
ENABLE_WEATHER=true
ENABLE_CALCULATOR=true
MAX_TOOL_ITERATIONS=3

# ─── Deezer (OPTIONNEL) ────────────────────────────────────────────────────────
DEEZER_APP_ID=
DEEZER_APP_SECRET=
DEEZER_REDIRECT_URI=http://localhost:5173/callback/deezer
